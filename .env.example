# Modelo: copie para .env e preencha os quatro campos de rede antes de iniciar.
# Use os IPs reais e estaveis dos dois nos e a rede dos clientes em CIDR.
# Fixe os IPs por reserva no DHCP da rede ou IP estatico na maquina.
# Este arquivo nao configura o endereco da interface de rede.
# DNS_BIND_ADDRESS deve ser o IP desta maquina, de acordo com BIND_ROLE.
# Consulte tutoriais/dns/bind9/README.md para exemplos e identificacao da rede.
BIND_ROLE=primario
DNS_PRIMARY_IP=
DNS_SECONDARY_IP=
DNS_BIND_ADDRESS=
DNS_CLIENT_CIDR=
DNS_PORT=53
