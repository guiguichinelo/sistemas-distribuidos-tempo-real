# Laboratorio em um computador: copie para .env.local e use --env-file .env.local.
# Valores prontos para uso; altere apenas se houver conflito de rede ou porta.
# Esta rede e interna ao Docker, independente da LAN do computador.
# Ao mudar a subnet, ajuste tambem os dois IPs internos.
LOCAL_DNS_SUBNET=172.30.53.0/24
LOCAL_DNS_PRIMARY_IP=172.30.53.10
LOCAL_DNS_SECONDARY_IP=172.30.53.11
# Portas no host; ambos os BIND continuam usando 53 dentro do Docker.
LOCAL_DNS_PRIMARY_PORT=1053
LOCAL_DNS_SECONDARY_PORT=2053
